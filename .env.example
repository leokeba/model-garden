# HuggingFace Token for accessing private models and datasets
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# HuggingFace cache directory (IMPORTANT: Point this to a large storage location)
# The default ~/.cache/huggingface can fill up small SSDs quickly
# Recommended: Use /scratch/huggingface or another large storage mount
HF_HOME=/scratch/huggingface

# Models directory (where trained models are saved)
# Default: ./models (relative to project root)
# Recommended: Use /scratch/models or another large storage mount
MODELS_DIR=/scratch/models

# Server configuration
# SERVER_PORT=8888
# SERVER_HOST=0.0.0.0

# Queue Worker Configuration
# Enable/disable the background queue worker for autonomous job processing
MODEL_GARDEN_QUEUE_WORKER_ENABLED=true

# Maximum number of training jobs to run concurrently
# Default: 1 (sequential execution to prevent GPU memory conflicts)
# Increase only if you have multiple GPUs or sufficient memory
MODEL_GARDEN_MAX_CONCURRENT_TRAINING_JOBS=1

# How often the queue worker checks for new jobs (in seconds)
# Default: 5.0 (check every 5 seconds)
MODEL_GARDEN_QUEUE_POLL_INTERVAL=5.0
